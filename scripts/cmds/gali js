global.galiRunning = global.galiRunning || new Set();

module.exports.config = {
name: "gali",
version: "2.0.0",
hasPermssion: 0,
credits: "Rayhan",
description: "Gali Roast Command",
commandCategory: "Fun",
usages: "!gali / !gali stop",
cooldowns: 3
};

module.exports.run = async function ({ api, event, args }) {
const threadID = event.threadID;
const running = global.galiRunning;

if (args[0] && args[0].toLowerCase() === "stop") {
running.delete(threadID);
return api.sendMessage(
"🛑 Gali বন্ধ করা হয়েছে!",
threadID,
event.messageID
);
}

if (running.has(threadID)) {
return api.sendMessage(
"⚠️ Gali ইতিমধ্যে চলছে! বন্ধ করতে !gali stop লেখো।",
threadID
);
}

const gali = [
"খানকির পোলা, এত ভাব কিসের রে? 😈",
"মাদারচোদ, তোর নাটক আর কত দেখব! 💀",
"শালা হারামজাদা, বেশি লাফাস কেন? 🤬",
"ফাজিলের বাচ্চা, তোরে দেখলেই হাসি পায়! 😂",
"বেকুবের হাড্ডি, মাথায় কি গোবর ভরা? 🤡",
"শালা বাটপার, তোর ভাব দেখে আকাশও হাসে! 🤣",
"হারামির হাড্ডি, তোর লজিক কই গেল? 🔥",
"ওই ফাজিল, তুই কি কমেডি করতে জন্মাইছস? 😂",
"শালা গাধা, নিজের বুদ্ধি নিজেই খুঁজে বের কর! 😈",
"তুই এক নম্বরের পাগল, দুই নম্বরের ফাজিল! 💀",
"বেশি পাকনামি করিস না, রোস্ট খেয়ে যাবি! 🔥",
"শালা, তোর কথা শুনলে মাথা ঘুরে যায়! 🤣",
"ওই বেকুব, তোর ব্রেইন কি এখনো ঘুমায়? 🥱",
"ফাজিলের ফ্যাক্টরি, তোর ছুটি কবে হবে? 😂",
"শালা, তোরে নিয়ে হাসির প্রতিযোগিতা করা যায়! 🤡",
"হারামজাদা, তোর কাণ্ড দেখে কমেডিও লজ্জা পায়! 😈",
"ওই গাধা, বেশি ভাব নিস না! 💀",
"তুই পুরাই ঝামেলার প্যাকেট! 😂",
"শালা, তোরে রোস্ট করতে আলাদা প্রতিভা লাগে না! 🔥",
"ফাজিল কিং, তোর রাজত্ব শুধু গ্রুপের মধ্যেই! 🤣"
];

running.add(threadID);

try {
for (let i = 0; i < 10; i++) {
if (!running.has(threadID)) break;

  await new Promise(resolve => setTimeout(resolve, 2000));

  if (!running.has(threadID)) break;

  const msg = gali[Math.floor(Math.random() * gali.length)];

  await new Promise(resolve => {
    api.sendMessage(msg, threadID, () => resolve());
  });
}

} finally {
running.delete(threadID);
}
};
