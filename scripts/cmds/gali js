
module.exports.config = {
    name: "gali",
    version: "3.0.0",
    role: 0,
    author: "Rayhan",
    description: "Bangla Funny Gali",
    category: "fun",
    guide: "{pn} @mention",
    coolDown: 5
};

module.exports.onStart = async function ({ api, event }) {
    const galiList = [
        "😂 আরে বোকাচন্দর!",
        "🐔 গাধার বাচ্চা!",
        "🤣 আহাম্মকের বাদশা!",
        "😜 ফাজিলের ফ্যাক্টরি!",
        "🤦 উল্টা বুদ্ধির কারখানা!",
        "🐐 পাগলা ছাগল!",
        "👑 ফাজিলের সর্দার!",
        "😂 মাথায় কি গোবর ভরা?",
        "🤣 বুদ্ধি কি ছুটিতে গেছে?",
        "😎 দুই টাকার নবাব!",
        "🥔 আলুভর্তা মার্কা বুদ্ধি!",
        "😂 হাঁদারাম কোথাকার!",
        "🤡 তুই তো চলন্ত কমেডি শো!",
        "🏆 ফাজলামির বিশ্বচ্যাম্পিয়ন!",
        "😆 ঢংবাজের ডিলার!",
        "🐣 বুদ্ধির গোডাউন খালি!",
