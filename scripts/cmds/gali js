        `💬 ${randomGali}`,
        "",
        "╰━━━━━━━━━━━━━━━━━━╯",
        "💚 Powered by Rayhan"
    ].join("\n");

    return api.sendMessage(
        message,
        event.threadID,
        event.messageID
    );
};
