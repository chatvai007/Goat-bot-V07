        "👑 গবেট সম্রাট হাজির!",
        "😜 তুই তো ঢংয়ের দোকান!"
    ];

    const mentions = event.mentions || [];
    const randomGali =
        galiList[Math.floor(Math.random() * galiList.length)];

    let name = "";

    if (mentions.length > 0) {
        name = mentions[0].name;
    }

    const message = [
        "╭━━━〔 💚 বাংলা গালি 💚 〕━━━╮",
        "",
        name ? `🎯 টার্গেট: ${name}` : "😂 মজার গালি হাজির!",
